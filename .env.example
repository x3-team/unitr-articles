# ---- Боевой сервер (unitr.ru) ----
# Публичный адрес сайта: используется в canonical, Open Graph, sitemap.xml, robots.txt
SITE_URL=https://unitr.ru

# Источник данных: graphql (боевой WordPress) или mock (демо-данные из src/content/mock)
CONTENT_SOURCE=graphql

# GraphQL WordPress (headless). Читается ТОЛЬКО на сервере, в клиентский JS не попадает.
WP_GRAPHQL_URL=https://manage.unitr.ru/graphql
# Служебный токен (Application Password в виде "user:app-password" или Bearer JWT).
WP_GRAPHQL_TOKEN=
# basic | bearer
WP_GRAPHQL_AUTH=basic

# Рубрика раздела «Статьи» в WordPress
ARTICLES_CATEGORY=poleznye-stati
# Количество анонсов на странице. Если не задано — берётся из WordPress
# («Настройки → Раздел «Статьи»» плагина раздела), иначе 10.
ARTICLES_PER_PAGE=

# Время жизни кеша данных (секунды), не более 450: вместе с ISR-кешем страниц (300 с) худший случай < 15 минут
REVALIDATE_SECONDS=300
# Секрет вебхука мгновенной ревалидации (POST /api/revalidate)
REVALIDATE_SECRET=

# Правила robots.txt основного сайта (этот файл заменяет его robots.txt), строки через \n.
# Запреты для /articles/ отбрасываются автоматически. Пример: Disallow: /search\nDisallow: /cart
ROBOTS_EXTRA=
# Страницы основного сайта (SPA), которых нет в WordPress, — для sitemap.xml
SITE_STATIC_PAGES=[{"path":"/","lastmod":"2026-10-01"},{"path":"/catalog/","lastmod":"2026-10-01"}]
# Адрес, по которому middleware обращается к самому приложению за картой прежних адресов
# (по умолчанию http://127.0.0.1:$PORT — напрямую, минуя nginx)
INTERNAL_ORIGIN=
